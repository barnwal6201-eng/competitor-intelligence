# Copy to .env for local development.
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# MongoDB Atlas connection string. REQUIRED from Phase 2 onwards:
# auth (register/login) needs a database. Without it, /api/auth returns 503.
# Free Atlas cluster: https://www.mongodb.com/atlas — Database Access + Network
# Access (allow 0.0.0.0/0 for testing, or your IP), then Connect > Drivers.
MONGODB_URI=
# Long random secret for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real secret, and never reuse the dev fallback in production.
JWT_SECRET=
# Phase 6: OpenAI API key for AI analysis (POST /api/competitors/:id/analyze).
# Get one at https://platform.openai.com/api-keys — it is NOT your ChatGPT
# login, and a ChatGPT subscription does NOT include API credits: the API
# needs its own billing/payment method on the same OpenAI account.
# Without this key the app still works; only analysis returns a 503.
# Never commit a real key. Restart the backend after adding it.
OPENAI_API_KEY=
# Optional: override the analysis model (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Phase 9: Redis for BullMQ background scans. Local: install redis-server
# and run `redis-server` (default port 6379). Without Redis the app still
# starts — manual scans run synchronously and scheduled scans are paused.
REDIS_URL=redis://127.0.0.1:6379
# Phase 9: run the scan worker inside the API process (default true in
# development, so one `npm run dev` is enough). Set to false in production
# and run the separate worker with `npm run worker` instead.
SCAN_WORKER_IN_PROCESS=true
# Phase 9: how many scans the worker runs at once (default 2).
SCAN_WORKER_CONCURRENCY=2
# Phase 10: Notion + Salesforce integrations. Both are optional — without
# them the app still works; only Connect returns a plain message saying
# what to add. Nothing here is needed for scans, battlecards, or analysis.
# --- Tokens are encrypted at rest (AES-256-GCM). REQUIRED before any
# integration can connect: a 64-character hex key (32 random bytes).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this key ever changes, stored tokens can no longer be decrypted —
# disconnect and reconnect the integrations.
INTEGRATION_ENCRYPTION_KEY=
# --- Notion: create a PUBLIC integration at https://www.notion.so/my-integrations
# (capabilities: Read content, Insert content; no user info needed). Set its
# redirect URI to NOTION_REDIRECT_URI below, then paste the OAuth client id
# ("OAuth client ID") and secret ("OAuth client secret") here. In production
# the redirect URI must be your public backend URL, e.g.
# https://api.yourdomain.com/api/integrations/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:5000/api/integrations/notion/callback
# --- Salesforce: in Setup → App Manager → New Connected App, enable OAuth,
# add the callback URL (SALESFORCE_REDIRECT_URI below) and the scopes
# "Access and manage your data (api)" + "Perform requests at any time
# (refresh_token, offline_access)". Paste the Consumer Key / Secret here.
# A free Developer Edition org works for testing: https://developer.salesforce.com
# SALESFORCE_LOGIN_URL is https://login.salesforce.com by default; use
# https://test.salesforce.com for a sandbox org.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:5000/api/integrations/salesforce/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com
