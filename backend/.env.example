# Copy to .env for local development.
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# MongoDB Atlas connection string. REQUIRED from Phase 2 onwards:
# auth (register/login) needs a database. Without it, /api/auth returns 503.
# Free Atlas cluster: https://www.mongodb.com/atlas — Database Access + Network
# Access (allow 0.0.0.0/0 for testing, or your IP), then Connect > Drivers.
MONGODB_URI=
# Long random secret for signing login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real secret, and never reuse the dev fallback in production.
JWT_SECRET=
